{
  "name": "pandao-artwork-code-audit",
  "version": "0.1.1",
  "description": "Audit packaging proof pages against an approved GTIN manifest, including linear and Digital Link code agreement, missing pages and duplicate artwork.",
  "type": "module",
  "bin": {
    "artwork-code-audit": "bin/audit.mjs"
  },
  "files": [
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/audit.test.mjs",
    "example": "node bin/audit.mjs --manifest docs/samples/approved.csv --artwork docs/samples/proofs.pdf --out demo-output"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "author": "PANDAO <tianchaodaxing@gmail.com>",
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "pdfjs-dist": "6.3.289",
    "zxing-wasm": "3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tianchaodaxing-beep/pandao-artwork-code-audit.git"
  }
}
